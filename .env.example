# ────────────────────────────────────────────────────────────────
#  Elysia — fichier d'exemple de configuration
#  Copiez ce fichier en `.env` puis remplissez les valeurs.
#  ⚠️  Ne partagez JAMAIS votre token et ne le committez jamais.
# ────────────────────────────────────────────────────────────────

# [OBLIGATOIRE] Token du bot — Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=collez_votre_token_ici

# [OBLIGATOIRE] Application ID — Developer Portal > General Information
CLIENT_ID=000000000000000000

# [RECOMMANDÉ] Serveur de développement : les slash-commands y sont
# enregistrées instantanément. Vide = enregistrement global (jusqu'à 1 h).
DEV_GUILD_ID=

# [RECOMMANDÉ] Vos IDs Discord (propriétaires) — séparés par des virgules.
# Donne accès aux commandes sensibles (/reload, /eval-free, blacklist…).
# Activez le mode développeur Discord puis clic droit > Copier l'identifiant.
OWNER_IDS=

# ── Serveur web interne (obligatoire sur Render) ────────────────
# Render fournit automatiquement PORT ; en local laissez 3000.
PORT=3000
HOST=0.0.0.0
# Jeton optionnel protégeant les pages sensibles du site intégré (/donnees)
# et les routes internes /api/cases, /api/notes, /api/reminders, /api/logs.
# Vide = accès libre. Générez-en un avec : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DASHBOARD_TOKEN=

# ── 🔐 Onglet admin caché (/admin) ──────────────────────────────
# Page non listée dans la navigation, protégée par un code. Pour y accéder :
#   • 7 clics rapides sur le logo (ou sur « Elysia v1.0.0 » en bas de page) ;
#   • ou Ctrl/Cmd + Maj + A depuis n'importe quelle page ;
#   • ou en tapant directement l'adresse : https://VOTRE-SERVICE.onrender.com/admin
# ⚠️ CHANGEZ CE CODE : « 1357 » est la valeur par défaut publique.
# Un code long (16 caractères ou plus) est fortement recommandé :
#   node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
ADMIN_PANEL_CODE=1357
# Durée d'une session admin (minutes) — prolongée à chaque action.
ADMIN_SESSION_TTL_MINUTES=60
# Verrouillage anti-brute-force après 5 échecs (secondes).
ADMIN_LOCKOUT_SECONDS=900
# Liste blanche d'IP autorisées (séparées par des virgules). Vide = toutes les IP.
# Exemple : ADMIN_ALLOWED_IPS=82.64.12.34,2001:db8::1
ADMIN_ALLOWED_IPS=

# ── 🧪 Simulateur de raid (outil de TEST uniquement) ────────────
# ⚠️ VIDER CETTE VARIABLE SUR UN SERVEUR DE PRODUCTION.
# Le simulateur refuse tout serveur absent de cette liste : sans identifiant
# ici, la fonctionnalité est totalement désactivée (aucune action possible).
# Indiquez UNIQUEMENT l'identifiant de votre serveur de test, par exemple :
#   RAID_SIM_GUILD_IDS=123456789012345678
RAID_SIM_GUILD_IDS=

# ── Journalisation ──────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty

# ── Divers ──────────────────────────────────────────────────────
# Locale par défaut : fr | en
DEFAULT_LOCALE=fr
# URL publique du service Render (utilisée par l'auto-ping interne, optionnel)
SELF_PING_URL=
# Intervalle de l'auto-ping en minutes (0 = désactivé)
SELF_PING_INTERVAL=14
# Mode « dry run » : démarre uniquement le serveur web + les panneaux de démo,
# sans se connecter à Discord. Utile pour tester le déploiement. (1 = activé)
DRY_RUN=0

# ── Modules communautaires ──────────────────────────────────────
# Fuseau horaire utilisé pour déterminer « quel jour on est » lors des
# annonces d'anniversaires (/anniversaire). Ex. Europe/Paris, Africa/Dakar,
# America/Toronto… (voir /heure pour la liste des villes proposées)
BIRTHDAY_TIMEZONE=Europe/Paris

# ── Publication des slash-commands ──────────────────────────────
# auto   → (recommandé) serveur de dev si DEV_GUILD_ID est défini, sinon global
# guild  → uniquement DEV_GUILD_ID (instantané, idéal en développement)
# global → partout (propagation jusqu'à 1 h)
# both   → les deux ⚠️ : chaque commande apparaît alors EN DOUBLE sur le
#          serveur de développement (section serveur + section globale)
# Quelle que soit la valeur, Elysia nettoie l'autre portée au démarrage :
# une commande n'est jamais proposée deux fois.
COMMANDS_SCOPE=auto
