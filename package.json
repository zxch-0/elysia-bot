{
  "name": "elysia-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Elysia — bot Discord tout-en-un : modération avancée, giveaways et panneaux de rôles avec images.",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "validate": "tsx scripts/validate.ts",
    "preview": "tsx src/index.ts",
    "self-test": "tsx scripts/self-test.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
